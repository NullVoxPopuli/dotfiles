# Vim files I normally disable, or move to a HOME directory
*.session.vim
*.swp
*.swo
.netrwhist
packer_compiled.lua 

# MacOS
.DS_Store

# Don't show new themes
home/.themes

# Don't show new local applications
home/Applications

# Git clones which are updated during install
os/mac/home/.config/alacritty/themes/

# Compiled from the .gschema.xml next to it during install
home/.local/share/gnome-shell/extensions/*/schemas/gschemas.compiled
